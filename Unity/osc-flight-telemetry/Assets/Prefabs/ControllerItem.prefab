--- !u!114 &4495696638939273378
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8667523601583417197}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e61061896c654489a41575fc291bf4a0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: ClusterVR.CreatorKit.Item.Implements::ClusterVR.CreatorKit.Item.Implements.ScriptableItem
  sourceCodeAsset: {fileID: 0}
  sourceCode: "let currentOwner = null;\r\n\r\nfunction activateOwner(owner) {\r\n 
    if (owner === null) return;\r\n\r\n  $.log(\"activateOwner: \" + owner.id);\r\n 
    $.setPlayerScript(owner);\r\n  owner.send(\"setOscActive\", true);\r\n}\r\n\r\nfunction
    deactivateOwner(owner) {\r\n  if (owner === null) return;\r\n\r\n  $.log(\"deactivateOwner:
    \" + owner.id);\r\n  owner.send(\"setOscActive\", false);\r\n}\r\n\r\n$.onInteract((player)
    => {\r\n  $.log(\"ControllerItem interacted by: \" + player.id);\r\n  $.requestOwner(player);\r\n});\r\n\r\n$.onStart(()
    => {\r\n  const owner = $.getOwner();\r\n  if (owner !== null) {\r\n    currentOwner
    = owner;\r\n    activateOwner(owner);\r\n  }\r\n});\r\n\r\n$.onUpdate(() => {\r\n 
    const owner = $.getOwner();\r\n  if (owner === null) return;\r\n\r\n  if (currentOwner
    !== null && currentOwner.id === owner.id) return;\r\n\r\n  if (currentOwner !==
    null) {\r\n    deactivateOwner(currentOwner);\r\n  }\r\n\r\n  currentOwner =
    owner;\r\n  activateOwner(owner);\r\n});"
--- !u!114 &1833349987150326893
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8667523601583417197}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: acb59730322447a7a13c40b87493e196, type: 3}
  m_Name: 
  m_EditorClassIdentifier: ClusterVR.CreatorKit.Item.Implements::ClusterVR.CreatorKit.Item.Implements.PlayerScript
  sourceCodeAsset: {fileID: 0}
  sourceCode: "const aileronSliderObj = _.playerLocalObject(\"aileronSlider\");\r\nconst
    elevatorSliderObj = _.playerLocalObject(\"elevatorSlider\");\r\nconst rudderSliderObj
    = _.playerLocalObject(\"rudderSlider\");\r\n\r\nconst rotateTargetId = _.worldItemReference(\"rotateTarget\");\r\n\r\nlet
    initialized = false;\r\nlet oscActive = false;\r\nlet timer = 0;\r\n\r\nlet lastAileron
    = null;\r\nlet lastElevator = null;\r\nlet lastRudder = null;\r\n\r\n_.onReceive((messageType,
    arg, sender) => {\r\n  if (messageType === \"setOscActive\") {\r\n    oscActive
    = !!arg;\r\n    _.log(\"setOscActive = \" + oscActive);\r\n    return;\r\n  }\r\n\r\n 
    if (messageType === \"rotAileron\" && arg) {\r\n    _.log(\"received rotAileron\");\r\n   
    if (_.oscHandle.isSendEnabled()) {\r\n      _.oscHandle.send(new OscMessage(\"/plane/aileron/quat\",
    [\r\n        OscValue.float(arg.x),\r\n        OscValue.float(arg.y),\r\n       
    OscValue.float(arg.z),\r\n        OscValue.float(arg.w),\r\n      ]));\r\n   
    }\r\n    return;\r\n  }\r\n\r\n  if (messageType === \"rotElevator\" && arg)
    {\r\n    _.log(\"received rotElevator\");\r\n    if (_.oscHandle.isSendEnabled())
    {\r\n      _.oscHandle.send(new OscMessage(\"/plane/elevator/quat\", [\r\n       
    OscValue.float(arg.x),\r\n        OscValue.float(arg.y),\r\n        OscValue.float(arg.z),\r\n       
    OscValue.float(arg.w),\r\n      ]));\r\n    }\r\n    return;\r\n  }\r\n\r\n 
    if (messageType === \"rotRudder\" && arg) {\r\n    _.log(\"received rotRudder\");\r\n   
    if (_.oscHandle.isSendEnabled()) {\r\n      _.oscHandle.send(new OscMessage(\"/plane/rudder/quat\",
    [\r\n        OscValue.float(arg.x),\r\n        OscValue.float(arg.y),\r\n       
    OscValue.float(arg.z),\r\n        OscValue.float(arg.w),\r\n      ]));\r\n   
    }\r\n    return;\r\n  }\r\n}, { item: true, player: true });\r\n\r\n_.onFrame((dt)
    => {\r\n  if (!initialized) {\r\n    initialized = true;\r\n    _.log(\"PlayerScript
    initialized\");\r\n    _.log(\"aileronSliderObj = \" + (aileronSliderObj !==
    null));\r\n    _.log(\"elevatorSliderObj = \" + (elevatorSliderObj !== null));\r\n   
    _.log(\"rudderSliderObj = \" + (rudderSliderObj !== null));\r\n    _.log(\"rotateTargetId
    = \" + rotateTargetId);\r\n  }\r\n\r\n  if (!oscActive) return;\r\n\r\n  timer
    += dt;\r\n  if (timer < 0.05) return;\r\n  timer = 0;\r\n\r\n  if (aileronSliderObj
    !== null) {\r\n    const slider = aileronSliderObj.getUnityComponent(\"Slider\");\r\n   
    if (slider !== null) {\r\n      const v = slider.unityProp.value;\r\n      if
    (lastAileron === null || Math.abs(v - lastAileron) > 0.001) {\r\n        lastAileron
    = v;\r\n        _.log(\"send setAileron = \" + v);\r\n        _.sendTo(rotateTargetId,
    \"setAileron\", v);\r\n      }\r\n    }\r\n  }\r\n\r\n  if (elevatorSliderObj
    !== null) {\r\n    const slider = elevatorSliderObj.getUnityComponent(\"Slider\");\r\n   
    if (slider !== null) {\r\n      const v = slider.unityProp.value;\r\n      if
    (lastElevator === null || Math.abs(v - lastElevator) > 0.001) {\r\n        lastElevator
    = v;\r\n        _.log(\"send setElevator = \" + v);\r\n        _.sendTo(rotateTargetId,
    \"setElevator\", v);\r\n      }\r\n    }\r\n  }\r\n\r\n  if (rudderSliderObj
    !== null) {\r\n    const slider = rudderSliderObj.getUnityComponent(\"Slider\");\r\n   
    if (slider !== null) {\r\n      const v = slider.unityProp.value;\r\n      if
    (lastRudder === null || Math.abs(v - lastRudder) > 0.001) {\r\n        lastRudder
    = v;\r\n        _.log(\"send setRudder = \" + v);\r\n        _.sendTo(rotateTargetId,
    \"setRudder\", v);\r\n      }\r\n    }\r\n  }\r\n});"
