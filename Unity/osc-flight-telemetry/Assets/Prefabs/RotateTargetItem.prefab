--- !u!114 &7152589286158730321
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2484757701878352092}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e61061896c654489a41575fc291bf4a0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: ClusterVR.CreatorKit.Item.Implements::ClusterVR.CreatorKit.Item.Implements.ScriptableItem
  sourceCodeAsset: {fileID: 0}
  sourceCode: "const aileron = $.subNode(\"AileronPivot\");\r\nconst elevator = $.subNode(\"ElevatorPivot\");\r\nconst
    rudder = $.subNode(\"RudderPivot\");\r\n\r\nfunction inputToAngle(v, maxAngle)
    {\r\n  return v * maxAngle;\r\n}\r\n\r\n$.onStart(() => {\r\n  $.log(\"aileron=\"
    + (aileron !== null));\r\n  $.log(\"elevator=\" + (elevator !== null));\r\n 
    $.log(\"rudder=\" + (rudder !== null));\r\n});\r\n\r\n$.onReceive((messageType,
    arg, sender) => {\r\n  $.log(\"received = \" + messageType + \", arg = \" + arg);\r\n\r\n 
    if (typeof arg !== \"number\") {\r\n    $.log(\"arg is not number\");\r\n   
    return;\r\n  }\r\n\r\n  if (messageType === \"setAileron\") {\r\n    const angle
    = inputToAngle(arg, 60.0);\r\n    aileron.setRotation(\r\n      new Quaternion().setFromEulerAngles(new
    Vector3(0, 0, angle))\r\n    );\r\n    $.log(\"aileron rotated: \" + angle);\r\n\r\n   
    const q = aileron.getRotation();\r\n    if (sender && sender.send) {\r\n     
    sender.send(\"rotAileron\", q);\r\n    }\r\n    return;\r\n  }\r\n\r\n  if (messageType
    === \"setElevator\") {\r\n    const angle = inputToAngle(arg, 60.0);\r\n    elevator.setRotation(\r\n     
    new Quaternion().setFromEulerAngles(new Vector3(angle, 0, 0))\r\n    );\r\n   
    $.log(\"elevator rotated: \" + angle);\r\n\r\n    const q = elevator.getRotation();\r\n   
    if (sender && sender.send) {\r\n      sender.send(\"rotElevator\", q);\r\n   
    }\r\n    return;\r\n  }\r\n\r\n  if (messageType === \"setRudder\") {\r\n   
    const angle = inputToAngle(arg, 60.0);\r\n    rudder.setRotation(\r\n      new
    Quaternion().setFromEulerAngles(new Vector3(0, angle, 0))\r\n    );\r\n    $.log(\"rudder
    rotated: \" + angle);\r\n\r\n    const q = rudder.getRotation();\r\n    if (sender
    && sender.send) {\r\n      sender.send(\"rotRudder\", q);\r\n    }\r\n    return;\r\n 
    }\r\n}, { player: true });"
