      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 3641562096819788300, guid: 8d1b60769f138d244b195a8212fff96b,
        type: 3}
      propertyPath: m_LocalEulerAnglesHint.y
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 3641562096819788300, guid: 8d1b60769f138d244b195a8212fff96b,
        type: 3}
      propertyPath: m_LocalEulerAnglesHint.z
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 7152589286158730321, guid: 8d1b60769f138d244b195a8212fff96b,
        type: 3}
      propertyPath: sourceCode
      value: "const aileron = $.subNode(\"AileronPivot\");\r\nconst elevator = $.subNode(\"ElevatorPivot\");\r\nconst
        rudder = $.subNode(\"RudderPivot\");\r\n\r\nfunction inputToAngle(v, maxAngle)
        {\r\n  return v * maxAngle;\r\n}\r\n\r\n$.onStart(() => {\r\n  $.log(\"aileron=\"
        + (aileron !== null));\r\n  $.log(\"elevator=\" + (elevator !== null));\r\n 
        $.log(\"rudder=\" + (rudder !== null));\r\n});\r\n\r\n$.onReceive((messageType,
        arg, sender) => {\r\n  $.log(\"received = \" + messageType + \", arg = \"
        + arg);\r\n\r\n  if (typeof arg !== \"number\") {\r\n    $.log(\"arg is not
        number\");\r\n    return;\r\n  }\r\n\r\n  if (messageType === \"setAileron\")
        {\r\n    const angle = inputToAngle(arg, 60.0);\r\n    aileron.setRotation(\r\n     
        new Quaternion().setFromEulerAngles(new Vector3(0, 0, angle))\r\n    );\r\n   
        $.log(\"aileron rotated: \" + angle);\r\n\r\n    const q = aileron.getRotation();\r\n   
        if (sender && sender.send) {\r\n      sender.send(\"rotAileron\", q);\r\n   
        }\r\n    return;\r\n  }\r\n\r\n  if (messageType === \"setElevator\") {\r\n   
        const angle = inputToAngle(arg, 60.0);\r\n    elevator.setRotation(\r\n     
        new Quaternion().setFromEulerAngles(new Vector3(angle, 0, 0))\r\n    );\r\n   
        $.log(\"elevator rotated: \" + angle);\r\n\r\n    const q = elevator.getRotation();\r\n   
        if (sender && sender.send) {\r\n      sender.send(\"rotElevator\", q);\r\n   
        }\r\n    return;\r\n  }\r\n\r\n  if (messageType === \"setRudder\") {\r\n   
        const angle = inputToAngle(arg, 60.0);\r\n    rudder.setRotation(\r\n     
        new Quaternion().setFromEulerAngles(new Vector3(0, angle, 0))\r\n    );\r\n   
        $.log(\"rudder rotated: \" + angle);\r\n\r\n    const q = rudder.getRotation();\r\n   
        if (sender && sender.send) {\r\n      sender.send(\"rotRudder\", q);\r\n   
        }\r\n    return;\r\n  }\r\n}, { item: true, player: true });"
      objectReference: {fileID: 0}
    m_RemovedComponents: []
    m_RemovedGameObjects: []
    m_AddedGameObjects: []
    m_AddedComponents: []
  m_SourcePrefab: {fileID: 100100000, guid: 8d1b60769f138d244b195a8212fff96b, type: 3}
