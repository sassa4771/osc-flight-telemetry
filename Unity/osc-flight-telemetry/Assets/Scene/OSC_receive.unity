--- !u!114 &2186573
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2186564}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: acb59730322447a7a13c40b87493e196, type: 3}
  m_Name: 
  m_EditorClassIdentifier: ClusterVR.CreatorKit.Item.Implements::ClusterVR.CreatorKit.Item.Implements.PlayerScript
  sourceCodeAsset: {fileID: 0}
  sourceCode: "const airplaneHandle = _.worldItemReference(\"PlaneBody\");\r\n   
    if (airplaneHandle) {\r\n        _.sendTo(airplaneHandle, \"updateRotation\",
    [0, 0, 0]);\r\n    }\r\n_.oscHandle.onReceive(messages => {\r\n    if (!airplaneHandle)
    return;\r\n    messages.forEach((message) => {\r\n        if (message.address
    === \"/plane/data\") {\r\n            const v = message.values;\r\n           
    if (v && v.length >= 3) {\r\n                const roll = v[0].getFloat();\r\n               
    const pitch = v[1].getFloat();\r\n                const yaw = v[2].getFloat();\r\n               
    // \u30ED\u30B0\r\n                _.log([Player] Send to PlaneBody: ${roll.toFixed(1)});\r\n\r\n               
    _.sendTo(airplaneHandle, \"updateRotation\", [roll, pitch, yaw]);\r\n           
    }\r\n        }\r\n    });\r\n});"
