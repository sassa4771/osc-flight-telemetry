MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 919132148403279719}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e61061896c654489a41575fc291bf4a0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: ClusterVR.CreatorKit.Item.Implements::ClusterVR.CreatorKit.Item.Implements.ScriptableItem
  sourceCodeAsset: {fileID: 0}
  sourceCode: "$.onReceive((messageType, arg, sender) => {\r\n  if (messageType ===
    \"updateRotation\") {\r\n    const roll  = arg[0];\r\n    const pitch = arg[1];\r\n   
    const yaw   = arg[2];\r\n    $.log(`PlaneBody rotating: roll=${roll}`);\r\n   
    $.setRotation(new Quaternion().setFromEulerAngles(pitch, yaw, roll));\r\n  }\r\n},
    { item: true, player: true });"
