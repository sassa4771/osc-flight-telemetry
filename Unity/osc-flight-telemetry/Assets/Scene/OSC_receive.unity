MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 919132148403279719}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e61061896c654489a41575fc291bf4a0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: ClusterVR.CreatorKit.Item.Implements::ClusterVR.CreatorKit.Item.Implements.ScriptableItem
  sourceCodeAsset: {fileID: 0}
  sourceCode: "$.onReceive((messageName, args, sender) => {\r\n    $.log(`[Item]
    Received: ${messageName} | Data: ${JSON.stringify(args)}`);\r\n\r\n    if (messageName
    === \"updateRotation\") {\r\n        const roll = args[0];\r\n        const pitch
    = args[1];\r\n        const yaw = args[2];\r\n\r\n\r\n        const newRot =
    new Quaternion().setFromEulerAngles(pitch, yaw, roll);\r\n        \r\n       
    $.setRotation(newRot);\r\n    }\r\n}, { player: true });"
