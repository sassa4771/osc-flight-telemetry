--- !u!114 &353927069
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 353927061}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e61061896c654489a41575fc291bf4a0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: ClusterVR.CreatorKit.Item.Implements::ClusterVR.CreatorKit.Item.Implements.ScriptableItem
  sourceCodeAsset: {fileID: 0}
  sourceCode: "const MAX = 30.0;\r\nconst MIN = -30.0;\r\nconst oscTrigger = $.worldItemReference(\"Cube_OSC_Trigger\");\r\n\r\n$.onStart(()
    => {\r\n  $.state.aileron  = 0;\r\n  $.state.rudder   = 0;\r\n  $.state.elevator
    = 0;\r\n  updateText();\r\n});\r\n\r\nfunction updateText() {\r\n  const ailNode
    = $.subNode(\"Aileron_Text\");\r\n  const rudNode = $.subNode(\"Rudder_Text\");\r\n 
    const elvNode = $.subNode(\"Elevator_Text\");\r\n  if (ailNode) ailNode.getUnityComponent(\"TextMeshPro\").unityProp.text
    = `AIL: ${($.state.aileron).toFixed(1)}`;\r\n  if (rudNode) rudNode.getUnityComponent(\"TextMeshPro\").unityProp.text
    = `RUD: ${($.state.rudder).toFixed(1)}`;\r\n  if (elvNode) elvNode.getUnityComponent(\"TextMeshPro\").unityProp.text
    = `ELV: ${($.state.elevator).toFixed(1)}`;\r\n}\r\n\r\n$.onReceive((messageType,
    arg, sender) => {\r\n  if (messageType === \"buttonPress\") {\r\n    const axis
    = arg.axis;\r\n    let current = $.state[axis] ?? 0;\r\n    current = Math.max(MIN,
    Math.min(MAX, current + arg.dir));\r\n    $.state[axis] = current;\r\n    updateText();\r\n\r\n   
    // Cube_OSC_Trigger \u306EPlayerScript\u306BOSC\u9001\u4FE1\u3092\u4F9D\u983C\r\n   
    oscTrigger.send(\"sendToExternal\", [\r\n      $.state.aileron,\r\n      $.state.elevator,\r\n     
    $.state.rudder,\r\n    ]);\r\n  }\r\n}, { player: true });"
