  sourceCodeAsset: {fileID: 0}
  sourceCode: "const axis = \"aileron\";\r\nconst dir  = 1;\r\nconst panel = $.worldItemReference(\"ControlPanel\");\r\n\r\n$.onInteract(()
    => {\r\n  $.log(`interacted: panel=${panel ? \"found\" : \"null\"}`);\r\n  panel.send(\"buttonPress\",
    { axis: axis, dir: dir });\r\n});"
