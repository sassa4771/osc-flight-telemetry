  m_Script: {fileID: 11500000, guid: e61061896c654489a41575fc291bf4a0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: ClusterVR.CreatorKit.Item.Implements::ClusterVR.CreatorKit.Item.Implements.ScriptableItem
  sourceCodeAsset: {fileID: 0}
  sourceCode: "const axis = \"aileron\";\r\nconst dir  = 10;\r\nconst panel = $.worldItemReference(\"ControlPanel\");\r\n\r\n$.onInteract(()
    => {\r\n  $.log(`interacted: panel=${panel ? \"found\" : \"null\"}`);\r\n  panel.send(\"buttonPress\",
    { axis: axis, dir: dir });\r\n});"
